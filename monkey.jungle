project.manifest = manifest.xml

base.sourcePath = source
base.resourcePath = resources

# 폰트/문자열/설정은 모두 공통 resources/ (zzCadence 와 같은 폰트 크기 표).
# resources-kor/          한국어 문자열   (언어 한정자 폴더, 자동 적용)
# resources-edge550/ ...  기기별 런처 아이콘 (기기 한정자 폴더, 자동 적용)
#   540/840 = 35px (기본), 550/850 = 56px, 1040 = 40px, 1050/1060 = 68px
